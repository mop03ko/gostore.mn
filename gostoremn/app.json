{
  "expo": {
    "name": "GOStore",
    "slug": "gostoremn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gostore-icon.png",
    "scheme": "gostoremn",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/gostore-icon.png",
      "bundleIdentifier": "mn.gostore.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gostore-adaptive.png",
        "backgroundColor": "#27235e"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mn.gostore.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gostore-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#27235e",
          "image": "./assets/images/gostore-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Барааг зургаар хайхын тулд таны сонгосон зургийг ашиглана.",
          "cameraPermission": "Барааны зураг авч хайхын тулд камер ашиглана.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e080a821-71c8-481b-9ece-642bf7793d95"
      }
    },
    "owner": "morozkonkts-team"
  }
}
