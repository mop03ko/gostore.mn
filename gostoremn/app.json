{
  "expo": {
    "name": "gostore.mn",
    "slug": "gostoremn",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/gostore-icon.png",
    "scheme": "gostoremn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gostore-icon.png",
      "bundleIdentifier": "mn.gostore.app",
      "googleServicesFile": "./config/GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gostore-adaptive.png",
        "backgroundColor": "#27235e"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mn.gostore.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gostore-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#27235e",
          "image": "./assets/images/gostore-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Барааны зураг авч төстэй барааг хайхын тулд камер ашиглана.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Барааг зургаар хайх болон сэтгэгдэлд хавсаргахын тулд таны сонгосон зургийг ашиглана.",
          "cameraPermission": "Барааг хайх болон сэтгэгдэлд зураг хавсаргахын тулд камер ашиглана.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "orders",
          "color": "#f76a12"
        }
      ],
      "./plugins/with-firebase-ios",
      ["@react-native-firebase/analytics", { "ios": { "withoutAdIdSupport": true } }],
      ["expo-build-properties", { "ios": { "useFrameworks": "dynamic" } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e080a821-71c8-481b-9ece-642bf7793d95"
      }
    },
    "owner": "morozkonkts-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e080a821-71c8-481b-9ece-642bf7793d95"
    }
  }
}
