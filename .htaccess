AddDefaultCharset UTF-8
<IfModule mod_mime.c>
AddCharset UTF-8 .html .css .js
AddType font/ttf .ttf
</IfModule>
Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(config.*|.*\.sqlite.*|.*\.log|.*\.ai|.*\.pdf|.*\.zip|README\.md)$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?gostore\.mn(?::80)?$ [NC]
RewriteRule ^ https://gostore.mn%{REQUEST_URI} [R=308,L,NE]
RewriteRule ^(?:server|scripts|tests|tmp|output|\.git|\.vscode)(?:/|$) - [F,L]
RewriteRule ^v/(?:tb-)?[0-9]{5,20}/?$ index.html [L]
RewriteRule ^p/[a-z0-9-]{1,60}/?$ index.html [L]
RewriteRule ^account(?:/[a-z]{1,20})?/?$ index.html [L]
RewriteRule ^(?:cart|help)/?$ index.html [L]
RewriteRule ^brands/(?:nike|adidas|puma|newbalance|uniqlo|zara|sony|xiaomi|lego|ikea)/?$ index.html [L]
</IfModule>
